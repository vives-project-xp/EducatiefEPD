PG_PASS=replace-with-a-random-postgres-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret
# Externe basis-URL van het EPD (bijv. https://epd.school.be in productie, http://localhost:8001 lokaal).
# Hieruit worden de OIDC redirect-URIs (/oidc/callback/ en /accounts/login/) afgeleid.
EPD_BASE_URL=http://localhost:8001
EPD_OIDC_CLIENT_SECRET=replace-with-a-random-client-secret
EPD_OIDC_SECOND_CLIENT_SECRET=replace-with-a-different-random-client-secret
EPD_TEST_ADMIN_PASSWORD=replace-with-a-random-local-admin-password
EPD_TEST_STUDENT_PASSWORD=replace-with-a-random-student-password
EPD_TEST_TEACHER_PASSWORD=replace-with-a-random-teacher-password
EPD_TEST_MANAGER_PASSWORD=replace-with-a-random-manager-password
