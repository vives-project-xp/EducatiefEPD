DJANGO_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=epd.example.be
CSRF_TRUSTED_ORIGINS=https://epd.example.be
MYSQL_DATABASE=educatief_epd
MYSQL_USER=epd
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
SEED_DEMO=0
SECURE_SSL_REDIRECT=1

# Authentik is de normale aanmeldroute. Vul alle OIDC-waarden in voor de eerste start.
OIDC_ENABLED=1
EMERGENCY_LOGIN_ENABLED=0
OIDC_ISSUER=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
# Alleen voor een lokale Docker-host waarvan de interne hostnaam afwijkt van de browserhost.
OIDC_TOKEN_HOST_HEADER=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
OIDC_END_SESSION_ENDPOINT=
OIDC_GROUP_CLAIM=groups
OIDC_STUDENT_GROUPS=epd-studenten
OIDC_TEACHER_GROUPS=epd-docenten
OIDC_ADMIN_GROUPS=epd-beheerders
